{
  "name": "contextration",
  "version": "0.1.0",
  "private": true,
  "description": "An OTel-friendly context efficiency auditor for AI agents.",
  "license": "Apache-2.0",
  "homepage": "https://contextration.arbajsheikh720-0.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10HQ/contextration.git"
  },
  "bugs": {
    "url": "https://github.com/10HQ/contextration/issues"
  },
  "keywords": [
    "ai-agents",
    "context-engineering",
    "llm-evaluation",
    "opentelemetry"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "audit:demo": "tsx cli/audit.ts examples/support-agent.json",
    "test:unit": "tsx --test tests/*.test.ts",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vinext": "0.0.45",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
