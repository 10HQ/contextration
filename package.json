{
  "name": "contextration",
  "version": "0.1.0",
  "private": true,
  "description": "An OTel-friendly context efficiency auditor for AI agents.",
  "license": "Apache-2.0",
  "homepage": "https://contextration.arbajsheikh720-0.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10HQ/contextration.git"
  },
  "bugs": {
    "url": "https://github.com/10HQ/contextration/issues"
  },
  "keywords": [
    "ai-agents",
    "context-engineering",
    "llm-evaluation",
    "opentelemetry"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "audit:demo": "tsx cli/audit.ts examples/support-agent.json",
    "test:unit": "tsx --test tests/*.test.ts",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
