# ContextRation's included CLI, fixtures, tests, and build require no secrets.
#
# Configure OpenTelemetry exporters in the host application that embeds the
# library. These common OTel variables are examples only; ContextRation does not
# read them or start an exporter by itself.
# OTEL_SERVICE_NAME=contextration
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example/v1/traces
#
# Never place provider keys, authorization headers, raw prompts, messages,
# retrieved documents, or tool results in this file.
